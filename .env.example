# Optional server-side AI provider. Never put credentials in NEXT_PUBLIC_ variables.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local database location. Defaults to data/mvp.sqlite.
ACTIVITY_DB_PATH=

# Netlify provisions NETLIFY_DB_URL automatically. Keep that connection string secret.
# Local development without Netlify uses SQLite as before.
